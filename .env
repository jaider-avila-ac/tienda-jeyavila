# El PROPIO dominio de esta tienda, NUNCA el backend compartido directo — nginx.conf ya proxea
# /api/ y /ws hacia el backend desde acá (por la red interna de Docker). Si se llama directo al
# backend compartido, el navegador nunca toca el dominio real de la tienda, el backend no tiene
# cómo resolver el tenant por dominio y cae al respaldo (X-Tenant-Id) — un header que pone el
# propio cliente y que cualquiera puede cambiar con curl para ver el catálogo de OTRA tienda.
VITE_API_URL=https://tienda.jeyavilamusic.com

# Número de la tienda Jey Avila Music en el backend (el que muestra el panel de superadministrador).
# Respaldo para desarrollo local: en producción el backend reconoce la tienda por su dominio.
VITE_TENANT_ID=3

VITE_PUBLIC_SITE_URL=https://tienda.jeyavilamusic.com

# Client ID de Google OAuth (Google Cloud Console → Credentials). El dominio real de esta tienda
# debe agregarse UNA vez en "Authorized JavaScript origins" de ese Client ID.
VITE_GOOGLE_CLIENT_ID=608123125346-9iad9jvkl49j9f3hj5piipolbkjm1h56.apps.googleusercontent.com
